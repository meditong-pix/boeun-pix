s w:val="21"/></w:rPr><w:t xml:space="preserve">대응 지연 시  </w:t></w:r><w:r><w:rPr><w:color w:val="1F1E1C"/><w:sz w:val="21"/><w:szCs w:val="21"/></w:rPr><w:t xml:space="preserve">호텔리티 불만이 타 병동으로 확산되며 8월 전체 부정률 반등 가능</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="70"/><w:ind w:left="288"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="791F1F"/><w:sz w:val="21"/><w:szCs w:val="21"/></w:rPr><w:t xml:space="preserve">최악의 경우  </w:t></w:r><w:r><w:rPr><w:color w:val="1F1E1C"/><w:sz w:val="21"/><w:szCs w:val="21"/></w:rPr><w:t xml:space="preserve">환자경험평가 관련 문항 점수 하락 및 수가 가감산에 부정적 영향</w:t></w:r></w:p><w:p><w:pPr><w:pBdr><w:bottom w:val="single" w:color="0C447C" w:sz="6" w:space="6"/></w:pBdr><w:spacing w:after="180" w:before="440"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="0C447C"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr><w:t xml:space="preserve">5  </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="1F1E1C"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr><w:t xml:space="preserve">결론 및 제언</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="100" w:line="300"/></w:pPr><w:r><w:rPr><w:b w:val="false"/><w:bCs w:val="false"/><w:color w:val="1F1E1C"/><w:sz w:val="21"/><w:szCs w:val="21"/></w:rPr><w:t xml:space="preserve">아래 세 가지 대응 옵션 중 하나를 선택해 주시기 바랍니다.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="140"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="0C447C"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">옵션 A   </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="1F1E1C"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">영양팀·시설팀 합동 원인 점검 (1주 내)</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60"/><w:ind w:left="360"/></w:pPr><w:r><w:rPr><w:color w:val="5F5E5A"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">식사 배식 시간과 청소 동선을 재점검하고 개선안을 수립합니다. 가장 빠르게 악화 흐름을 멈출 수 있으나 실무 부담이 큽니다.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="140"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="0C447C"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">옵션 B   </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="1F1E1C"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">7병동 집중 모니터링 + 병동 담당자 면담</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60"/><w:ind w:left="360"/></w:pPr><w:r><w:rPr><w:color w:val="5F5E5A"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">신규 인력 배치 병동에 한해 밀착 관리합니다. 부담은 적으나 호텔리티 이슈 확산 방지 효과는 제한적입니다.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="40" w:before="140"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="0C447C"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">옵션 C   </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="1F1E1C"/><w:sz w:val="22"/><w:szCs w:val="22"/></w:rPr><w:t xml:space="preserve">현행 유지 + 월간 정기 모니터링</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="60"/><w:ind w:left="360"/></w:pPr><w:r><w:rPr><w:color w:val="5F5E5A"/><w:sz w:val="20"/><w:szCs w:val="20"/></w:rPr><w:t xml:space="preserve">전체 지표가 개선 추세인 만큼 별도 조치 없이 다음 달 재확인합니다. 호텔리티 악화가 일시적이라면 가장 효율적이나, 확산 시 대응이 늦어질 위험이 있습니다.</w:t></w:r></w:p><w:p><w:pPr><w:spacing w:after="0" w:before="60"/></w:pPr></w:p><w:p><w:pPr><w:pBdr><w:top w:val="single" w:color="CFCDC5" w:sz="4" w:space="8"/><w:bottom w:val="single" w:color="CFCDC5" w:sz="4" w:space="8"/><w:left w:val="single" w:color="0C447C" w:sz="24" w:space="10"/><w:right w:val="single" w:color="CFCDC5" w:sz="4" w:space="8"/></w:pBdr><w:shd w:fill="F6F5F2" w:val="clear"/><w:spacing w:after="260" w:before="60"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="1F1E1C"/><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t xml:space="preserve">결정은 경영진의 몫이나, 실무팀은 옵션 A(합동 점검)를 우선 권고합니다.</w:t></w:r></w:p><w:p><w:pPr><w:pBdr><w:bottom w:val="single" w:color="0C447C" w:sz="6" w:space="6"/></w:pBdr><w:spacing w:after="180" w:before="440"/></w:pPr><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="0C447C"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr><w:t xml:space="preserve">6  </w:t></w:r><w:r><w:rPr><w:b/><w:bCs/><w:color w:val="1F1E1C"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr><w:t xml:space="preserve">모니터링 계획</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="300"/></w:pPr><w:r><w:rPr><w:color w:val="1F1E1C"/><w:sz w:val="21"/><w:szCs w:val="21"/></w:rPr><w:t xml:space="preserve">8월 1주차: 호텔리티 관련 VOC 재접수 추이 중간 점검</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="300"/></w:pPr><w:r><w:rPr><w:color w:val="1F1E1C"/><w:sz w:val="21"/><w:szCs w:val="21"/></w:rPr><w:t xml:space="preserve">8월 3주차: 7병동 부정률 재평가, 개선 여부 확인</w:t></w:r></w:p><w:p><w:pPr><w:pStyle w:val="ListParagraph"/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:after="70" w:line="300"/></w:pPr><w:r><w:rPr><w:color w:val="1F1E1C"/><w:sz w:val="21"/><w:szCs w:val="21"/></w:rPr><w:t xml:space="preserve">8월 말: 전체 지표 재집계 후 다음 임원 보고에 반영</w:t></w:r></w:p><w:sectPr><w:pgSz w:w="11906" w:h="16838" w:orient="portrait"/><w:pgMar w:top="1134" w:right="1134" w:bottom="1134" w:left="1134" w:header="708" w:footer="708" w:gutter="0"/><w:pgNumType/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>